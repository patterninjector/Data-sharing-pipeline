{
  "name": "BannedBooksPipeline",
  "description": "Processes banned books dataset with filtering, anonymization, and aggregation and formatting ",
  "inputFile": "http://data-product-service.default:8089/data-json",
  "processingMode" : "BROKEN_URL",
  "steps": [
    {
      "service": "filter",
      "config": {
        "field": "firsteditionpublicationyear",
        "operator": ">",
        "value": 1930
      }
    },
    {
      "service": "anonymization",
      "config": {
        "fields": ["authorfirstname","authorlastname","ocrresult"],
        "method" : "mask"
      }
    }
  ]
}